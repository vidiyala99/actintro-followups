# Copy to .env and fill in. Never commit .env.
# Tinybird Rawtree (append-only event log): https://rawtree.com
TINYBIRD_HOST=https://api.rawtree.com
TINYBIRD_TOKEN=
# Nimble web data: https://docs.nimbleway.com
NIMBLE_API_KEY=
# AWS Bedrock uses your normal AWS credentials (AWS_PROFILE or env vars).
AWS_REGION=us-west-2
FOLLOWUPS_MODEL=moonshotai.kimi-k2.5

# Optional: a local Liquid model (llama-server) for the research filter. Left empty, Bedrock filters (see README).
LIQUID_URL=
